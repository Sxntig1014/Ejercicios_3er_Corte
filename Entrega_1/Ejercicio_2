#include <vector>
#include <algorithm>

class ATM {
private:
    long long count[5];
    int values[5] = {20, 50, 100, 200, 500};

public:
    ATM() {
        for(int i = 0; i < 5; ++i) count[i] = 0;
    }
    
    void deposit(std::vector<int> banknotesCount) {
        for(int i = 0; i < 5; ++i) {
            count[i] += banknotesCount[i];
        }
    }
    
    std::vector<int> withdraw(int amount) {
        std::vector<int> temp(5, 0);
        long long rem = amount;
        for(int i = 4; i >= 0; --i) {
            if(rem <= 0) break;
            long long needed = rem / values[i];
            long long take = std::min(needed, count[i]);
            temp[i] = take;
            rem -= take * values[i];
        }
        if(rem != 0) {
            return {-1};
        }
        for(int i = 0; i < 5; ++i) {
            count[i] -= temp[i];
        }
        return temp;
    }
};
